<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="0153135D" w14:textId="3AF0DBFC" w:rsidR="00FA682F" w:rsidRDefault="00B30B10" w:rsidP="00FA682F"><w:r><w:t>П</w:t></w:r><w:r w:rsidR="00FA682F"><w:t xml:space="preserve">олный опросник в стиле </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00FA682F"><w:t>Playtomic</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00FA682F"><w:t>: 5 вопросов с вариантами ответов по возрастанию уровня. Формулировки можешь адаптировать под свой клуб/форму.</w:t></w:r></w:p><w:p w14:paraId="07E0A6F1" w14:textId="5990C45C" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>Вопрос 1. Опыт игры в падел</w:t></w:r></w:p><w:p w14:paraId="50712997" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="20556EFB" w14:textId="52AD7137" w:rsidR="00FA682F" w:rsidRPr="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:pPr><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r><w:t>«Каков ваш опыт игры в падел?»</w:t></w:r></w:p><w:p w14:paraId="088F66F5" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="006D7B55" w14:textId="2959DDA2" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">1. «Никогда раньше не играл(а) в падел»  </w:t></w:r></w:p><w:p w14:paraId="03211372" w14:textId="77984785" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">2. «Играл(а) несколько раз, до 10 матчей всего»  </w:t></w:r></w:p><w:p w14:paraId="26F3AC4C" w14:textId="27FCB7F2" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">3. «Играю нерегулярно (примерно 1 раз в месяц)»  </w:t></w:r></w:p><w:p w14:paraId="6D25A134" w14:textId="252997B5" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">4. «Играю регулярно 1 раз в неделю»  </w:t></w:r></w:p><w:p w14:paraId="57A64548" w14:textId="47ADB798" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">5. «Играю 2–3 раза в неделю»  </w:t></w:r></w:p><w:p w14:paraId="7BFCD968" w14:textId="6E692EF0" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>6. «Играю 4 и более раз в неделю / участвую в турнирах»</w:t></w:r></w:p><w:p w14:paraId="2E2D6E0F" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="1FE3F1EB" w14:textId="18673871" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>Вопрос 2. Опыт в других ракеточных видах спорта</w:t></w:r></w:p><w:p w14:paraId="06C48E41" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="3D920AD6" w14:textId="5578AD7A" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>«Каков ваш опыт в других ракеточных видах спорта (теннис, сквош, бадминтон и т.д.)?»</w:t></w:r></w:p><w:p w14:paraId="26B68890" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="43A1C777" w14:textId="716DD314" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>1. «</w:t></w:r><w:r w:rsidR="00D33CF0"><w:t>Н</w:t></w:r><w:r><w:t xml:space="preserve">е занимался(ась) ракеточными видами спорта»  </w:t></w:r></w:p><w:p w14:paraId="306E0130" w14:textId="2FEE1619" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">2. «Играл(а) </w:t></w:r><w:r w:rsidR="00261B7D"><w:t xml:space="preserve">меньше </w:t></w:r><w:r w:rsidR="006F1F5A"><w:t>1 года</w:t></w:r><w:r><w:t xml:space="preserve">»  </w:t></w:r></w:p><w:p w14:paraId="073069EE" w14:textId="6720D3E5" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>3. «</w:t></w:r><w:r w:rsidR="006F1F5A"><w:t>Игра</w:t></w:r><w:r w:rsidR="00111795"><w:t>л</w:t></w:r><w:r w:rsidR="006F1F5A"><w:t>(а) от 1 до 3 лет</w:t></w:r><w:r w:rsidR="00111795"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t>любительский уровен</w:t></w:r><w:r w:rsidR="00A15CC4"><w:t>ь</w:t></w:r><w:r><w:t xml:space="preserve">»  </w:t></w:r></w:p><w:p w14:paraId="675C7A9E" w14:textId="109B52B4" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>4. «</w:t></w:r><w:r w:rsidR="00111795"><w:t xml:space="preserve">Играл(а) от 3 до 5 лет </w:t></w:r><w:r><w:t xml:space="preserve">уровень выше среднего»  </w:t></w:r></w:p><w:p w14:paraId="5F0083C7" w14:textId="7F37F2E0" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>5. «</w:t></w:r><w:r w:rsidR="00111795"><w:t>Играл(</w:t></w:r><w:r w:rsidR="00DF44E5"><w:t>а) более</w:t></w:r><w:r w:rsidR="00111795"><w:t xml:space="preserve"> 5 лет </w:t></w:r><w:r w:rsidR="00D33CF0"><w:t>участие в соревнованиях</w:t></w:r></w:p><w:p w14:paraId="31CC62AE" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="08F26A95" w14:textId="2532FD92" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>Вопрос 3. Техника ударов и игра у сетки</w:t></w:r></w:p><w:p w14:paraId="56EF808A" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="3D2300A1" w14:textId="0BF0237C" w:rsidR="00FA682F" w:rsidRPr="00E40A7B" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>«Как вы оцениваете свою технику ударов и игру у сетки?»</w:t></w:r></w:p><w:p w14:paraId="02DBF9CF" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="4C0B1B18" w14:textId="23A0467F" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">1. «Только осваиваю базовые удары, часто </w:t></w:r><w:r w:rsidR="00132A46"><w:t>ошибаюсь»</w:t></w:r></w:p><w:p w14:paraId="611B3798" w14:textId="67C2CA3A" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>2. «Могу стабильно перебросить мяч на другую сторону в простых розыгрышах</w:t></w:r><w:r w:rsidR="00C54051"><w:t>»</w:t></w:r></w:p><w:p w14:paraId="6C30A4D2" w14:textId="434A895E" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:lastRenderedPageBreak/><w:t>3. «</w:t></w:r><w:r w:rsidR="00C54051"><w:t xml:space="preserve">Стабильно играю слета, но </w:t></w:r><w:r><w:t xml:space="preserve">в быстрых розыгрышах часто ошибаюсь»  </w:t></w:r></w:p><w:p w14:paraId="21300DFE" w14:textId="3516B155" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>4. «Уверенно играю с задней линии и у сетки</w:t></w:r><w:r w:rsidR="00220F0B"><w:t>»</w:t></w:r></w:p><w:p w14:paraId="4B958CEF" w14:textId="0202DFA6" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">5. «Комфортно играю во всех зонах корта, разнообразно атакую, контролирую скорость и направление мяча»  </w:t></w:r></w:p><w:p w14:paraId="34325726" w14:textId="1D84BF7B" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>6. «Стабильно выполняю сложные атакующие удары (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>bandeja</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>vibora</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>smash</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>), умею менять ритм и навязывать свою игру»</w:t></w:r></w:p><w:p w14:paraId="0A461F28" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="3F25E68C" w14:textId="14CF3882" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>Вопрос 4. Игра от стен (от стекла)</w:t></w:r></w:p><w:p w14:paraId="2C0A585C" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="23EC908C" w14:textId="74D0A609" w:rsidR="00FA682F" w:rsidRPr="00E40A7B" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>«Как вы играете от стен (от стекла)?»</w:t></w:r></w:p><w:p w14:paraId="45721D81" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="45E2C51D" w14:textId="454CEF1A" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>1. «Практически не использую стены, теряюсь при отскоке мяча</w:t></w:r><w:r w:rsidR="00A15CC4"><w:t>»</w:t></w:r></w:p><w:p w14:paraId="27B0CEEA" w14:textId="16DF8A26" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">2. «Понимаю основную идею, иногда успеваю подстроиться под отскок, но часто ошибаюсь»  </w:t></w:r></w:p><w:p w14:paraId="44FEB7A1" w14:textId="18C39E49" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">3. «Уверенно принимаю простые мячи от задней стены, иногда использую боковые, но сложные отскоки пока даются с трудом»  </w:t></w:r></w:p><w:p w14:paraId="7AD78668" w14:textId="239C1F21" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">4. «Стабильно использую заднюю и боковые стены в защите, могу направлять мяч в нужную зону после отскока»  </w:t></w:r></w:p><w:p w14:paraId="394C4BB4" w14:textId="3762E8D7" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">5. «Комфортно чувствую себя у стен в быстром темпе, использую стены и для защиты, и для подготовки атаки»  </w:t></w:r></w:p><w:p w14:paraId="3F00FEE6" w14:textId="688B4E41" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>6. «Уверенно читаю любые отскоки, использую стены как тактическое оружие: меняю углы, темп и создаю соперникам неудобные мячи»</w:t></w:r></w:p><w:p w14:paraId="362FB468" w14:textId="2A6F113E" w:rsidR="00FA682F" w:rsidRPr="0058458B" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="5F28DA70" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="3D50E0AA" w14:textId="49BB2743" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>Вопрос 5. Общая самооценка уровня игры</w:t></w:r></w:p><w:p w14:paraId="62C7BBC3" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="237B1829" w14:textId="6AA7B03C" w:rsidR="00FA682F" w:rsidRPr="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>«Как вы в целом оцениваете свой текущий уровень игры в падел?»</w:t></w:r></w:p><w:p w14:paraId="445A9B16" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="62FC6BB0" w14:textId="4345FEC3" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">1. «Полный новичок — только пробую этот вид спорта»  </w:t></w:r></w:p><w:p w14:paraId="08BC30D5" w14:textId="6F4B4EF0" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">2. «Начинающий игрок — понимаю правила, могу поддержать простые розыгрыши»  </w:t></w:r></w:p><w:p w14:paraId="36AA1274" w14:textId="37202DB2" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">3. «Ниже среднего — уже играю регулярно, но мне не хватает стабильности и тактики»  </w:t></w:r></w:p><w:p w14:paraId="3592B306" w14:textId="6885DDB4" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">4. «Средний уровень — уверенно играю с соперниками своего уровня, понимаю основные тактические идеи»  </w:t></w:r></w:p><w:p w14:paraId="57EAC093" w14:textId="72972CA3" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">5. «Выше среднего — хорошо контролирую игру, умею использовать тактику, играю в равных матчах с сильными соперниками»  </w:t></w:r></w:p><w:p w14:paraId="63EAA79C" w14:textId="7C1B5D07" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>6. «Продвинутый/соревновательный игрок — регулярно играю на высоком уровне и/или участвую в турнира</w:t></w:r><w:r w:rsidR="0058458B"><w:t>х</w:t></w:r><w:r><w:t>»</w:t></w:r></w:p><w:p w14:paraId="3C2CEE34" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="30A999F3" w14:textId="59BA35EC" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">Привяжем твой опросник к шкале </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Playtomic</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> 0–7 так, чтобы стартовый уровень был реалистичным и совместим с их логикой (0–2 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>beginner</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, 2–4 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>intermediate</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, 4–5.5 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>advanced</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, 5.5+ </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>competitive</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>).</w:t></w:r></w:p><w:p w14:paraId="7583C1A9" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="5AA96E0C" w14:textId="2B20CAF2" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>1. Баллы за ответы</w:t></w:r></w:p><w:p w14:paraId="30EFB3BA" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="76CEB996" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">У тебя в каждом вопросе 1–6 вариантов.  </w:t></w:r></w:p><w:p w14:paraId="73B2B995" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t>Дадим им баллы от 0 до 5:</w:t></w:r></w:p><w:p w14:paraId="2A868057" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"/><w:p w14:paraId="04F66326" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">- Вариант 1 → 0 баллов  </w:t></w:r></w:p><w:p w14:paraId="7B465E9A" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">- Вариант 2 → 1 балл  </w:t></w:r></w:p><w:p w14:paraId="55A823D1" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">- Вариант 3 → 2 балла  </w:t></w:r></w:p><w:p w14:paraId="2E72FC18" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">- Вариант 4 → 3 балла  </w:t></w:r></w:p><w:p w14:paraId="0C3DDF2B" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">- Вариант 5 → 4 балла  </w:t></w:r></w:p><w:p w14:paraId="3CA71BCF" w14:textId="77777777" w:rsidR="00FA682F" w:rsidRDefault="00FA682F" w:rsidP="00FA682F"><w:r><w:t xml:space="preserve">- Вариант 6 → 5 баллов  </w:t></w:r></w:p><w:p w14:paraId="71E2ADF6" w14:textId="77777777" 